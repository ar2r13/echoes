{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"experimentalDecorators": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"useDefineForClassFields": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/sw.ts"]
}
